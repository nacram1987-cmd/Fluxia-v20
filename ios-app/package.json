{
  "name": "fluxia-elite-ios",
  "version": "1.5.0",
  "private": true,
  "description": "Fluxia Elite iOS Capacitor shell (development only)",
  "scripts": {
    "ios:add": "npx cap add ios",
    "ios:sync": "node scripts/verify-web-bundle.mjs && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "verify": "node scripts/verify-web-bundle.mjs",
    "verify:native": "node scripts/verify-native-scaffold.mjs",
    "ios:sync:dev": "node scripts/verify-development-bundle.mjs && npx cap sync ios",
    "verify:dev": "node scripts/verify-native-scaffold.mjs && node scripts/verify-development-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
